# Visual Studio 2015 user specific files
.vs/

# JetBrains Rider / IntelliJ user specific files
.idea/
Plugins/Developer/RiderLink/

# oh-my-codex local runtime state
.omc/
.omx/

# Agent scratch state and prompt reference assets
.agents/work/
.agents/prompt-assets/

# UnreelMCP plugin
Plugins/UnreelMCP/Resources/mcp-bridge/node_modules/**/*
Plugins/UnreelMCP/Saved/*

# Temporary planning notes
Docs/temp/
docs/temp/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Additional IDE/user-specific files
*.user
*.userosscache
*.sln.docstates
*.rsuser

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*
Builds/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*
Saved/CodeIntent/

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Google Drive upload staging folder for ignored large assets.
gd-upload/
